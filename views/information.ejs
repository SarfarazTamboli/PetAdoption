<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Data</title>
  <link rel="stylesheet" href="../static/database.css">
</head>
<body>
  <header>
    Pet Selling Database
  </header>

  <section>
    <h2>Users</h2>
    <% if (users.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.email %></td>
              <td><%= user.role %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="no-data">No user data available.</p>
    <% } %>
  </section>

  <section>
    <h2>Dogs</h2>
    <% if (dogs.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Age</th>
            <th>Breed</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% dogs.forEach(dog => { %>
            <tr>
              <td><%= dog.petName %></td>
              <td><%= dog.petType %></td>
              <td><%= dog.petAge %></td>
              <td><%= dog.petBreed %></td>
              <td><%= dog.petDescription %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="no-data">No dog data available.</p>
    <% } %>
  </section>

  <section>
    <h2>Cats</h2>
    <% if (cats.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Age</th>
            <th>Breed</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% cats.forEach(cat => { %>
            <tr>
              <td><%= cat.petName %></td>
              <td><%= cat.petType %></td>
              <td><%= cat.petAge %></td>
              <td><%= cat.petBreed %></td>
              <td><%= cat.petDescription %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="no-data">No cat data available.</p>
    <% } %>
  </section>

  <section>
    <h2>Birds</h2>
    <% if (birds.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Age</th>
            <th>Breed</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% birds.forEach(bird => { %>
            <tr>
              <td><%= bird.petName %></td>
              <td><%= bird.petType %></td>
              <td><%= bird.petAge %></td>
              <td><%= bird.petBreed %></td>
              <td><%= bird.petDescription %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="no-data">No bird data available.</p>
    <% } %>
  </section>

  <footer>
    &copy; 2024 Pet Adoption Management
  </footer>
</body>
</html>
