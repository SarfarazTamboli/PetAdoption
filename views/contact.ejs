<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - PetAdopt</title>
  <link rel="stylesheet" href="../static/contact.css">  
</head>
<body>

  <% if (typeof message !== 'undefined' && message) { %>
    <div id="errorAlert" class="alert-modal">
      <div class="alert-content">
        <h3>Error</h3>
        <p id="alertMessage"><%= message %></p>
        <button id="closeError">OK</button>
      </div>
    </div>
  <% } %>

  <nav>
    <div class="logo">PetSelling</div>
    <ul>
      <li><a href="/home">Home</a></li>
      <li><a href="/dashboard">Browse & Adopt</a></li>
      <li><a href="/login">Login</a></li>
      <li><a href="/signup">Signup</a></li>
    </ul>
  </nav>

  <header class="contact-header">
    <h1>Contact Us</h1>
    <p>Have any questions? We'd love to hear from you!</p>
  </header>

  <section class="contact-form">
    <form action="/contact" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Enter your name" required>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required>
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="Write your message here" required></textarea>
      </div>

      <button type="submit" class="btn">Send Message</button>
    </form>
  </section>

  <footer>
    <div class="footer-container">
      <div class="footer-section">
        <h3>Follow Us</h3>
        <div class="social-icons">
          <a href="#"><img src="https://img.icons8.com/color/48/facebook.png" alt="facebook"/></a>
          <a href="#"><img src="https://img.icons8.com/fluency/48/instagram-new.png" alt="instagram-new"/></a>
          <a href="#"><img src="https://img.icons8.com/color/48/twitter--v1.png" alt="twitter"/></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 PetAdopt. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const errorAlert = document.getElementById('errorAlert');
    const closeError = document.getElementById('closeError');
    if (errorAlert) {
      errorAlert.style.display = 'flex';
      closeError.addEventListener('click', () => {
        errorAlert.style.display = 'none';
      });

      setTimeout(() => {
        errorAlert.style.display = 'none';
      }, 2000);
    }
  </script>
</body>
</html>
