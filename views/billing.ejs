<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buy Pet Online</title>
    <link rel="stylesheet" href="/static/billing.css">
    
    <!-- Flatpickr CSS for calendar styling -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>

   
      <% if (typeof message !== 'undefined' && message ) { %>
        <div id="successAlert" class="alert-modal">
          <div class="alert-content">
            <h3>Success</h3>
            <p id="successMessage"><%= message %></p>
            <button id="closeSuccess">OK</button>
          </div>
        </div>
      <% } %>

    <nav>
        <div class="logo">🐾 PetAdopt🐾</div>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="#">Contact</a></li>
          <li><a href="/dashboard">Browse & Buy</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="form-container">
            <h2>Complete Your Pet Purchase</h2>
            <form action="/Payment" method="POST">
                <!-- Basic Information Section -->
                <section class="section">
                    <h3>Basic Information</h3>
                    <div class="input-group">
                        <label for="first-name">First Name</label>
                        <input type="text" id="first-name" name="firstName" placeholder="owaise" required>
                    </div>
                    <div class="input-group">
                        <label for="last-name">Last Name</label>
                        <input type="text" id="last-name" name="lastName" placeholder="shaikh" required>
                    </div>
                    <div class="input-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="owaise.shaikh@example.com" required>
                    </div>
                    <div class="input-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="+91 765 456 7890" required>
                    </div>
                </section>

                <!-- Shipping Address Section -->
                <!-- <section class="section">
                    <h3>Shipping Address</h3>
                    <div class="input-group">
                        <label for="address">Street Address</label>
                        <input type="text" id="address" name="address" placeholder="1234 Elm St" required>
                    </div>
                    <div class="input-group">
                        <label for="city">City</label>
                        <input type="text" id="city" name="city" placeholder="Los Angeles" required>
                    </div>
                    <div class="input-group">
                        <label for="state">State/Province</label>
                        <input type="text" id="state" name="state" placeholder="California" required>
                    </div>
                    <div class="input-group">
                        <label for="zip">Zip Code</label>
                        <input type="text" id="zip" name="zip" placeholder="90001" required>
                    </div>
                    <div class="input-group">
                        <label for="country">Country</label>
                        <input type="text" id="country" name="country" placeholder="USA" required>
                    </div>
                </section> -->

                <!-- Payment Information Section -->
                <section class="section">
                    <h3>Payment Information</h3>
                    <div class="input-group">
                        <label for="payment-method">Payment Method</label>
                        <select id="payment-method" name="paymentMethod" required>
                            <option value="">Select Payment Method</option>
                            <option value="credit-card">Credit Card</option>
                            <!-- Add more options as needed -->
                        </select>
                    </div>

                    <div id="credit-card-info" class="payment-details">
                        <div class="input-group">
                            <label for="card-number">Credit Card Number</label>
                            <input type="text" id="card-number" name="cardNumber" placeholder="1234 5678 9876 5432" required>
                        </div>
                        <div class="input-group">
                            <label for="expiration-date">Expiration Date</label>
                            <!-- Flatpickr input for the expiration date -->
                            <input type="text" id="expiration-date" name=" expirationDate " required placeholder="MM / YYYY">
                        </div>
                        <div class="input-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" name="cvv" placeholder="123" required>
                        </div>
                    </div>
                </section>

                <!-- Hidden Pet Information -->
                <% if (typeof error !== 'undefined' && pet) { %>
                    <input type="hidden" id="pet-id" name="pet_id" value="<%= pet._id %>">
                    <input type="hidden" id="pet-type" name="petType" value="<%= pet.petType %>">
                    <input type="hidden" id="pet-Name" name="petName" value="<%= pet.petName %>">
                    <input type="hidden" id="pet-Age" name="petAge" value="<%= pet.petAge %>">
                    <input type="hidden" id="pet-Breed" name="petBreed" value="<%= pet.petBreed %>">
                    <input type="hidden" id="pet-Price" name="petPrice" value="<%= pet.petPrice %>">
                <% } %>

                <button type="submit" class="confirm-button">Confirm Purchase</button>
            </form>
        </div>

        <!-- Pet Details Section -->
        <div class="pet-details">
            <h3>Pet Details</h3>
            <% if (typeof error !== 'undefined' && pet) { %>
            <div class="pet-card">
                <img src="<%= pet.petImage %>" alt="<%= pet.petName %>" class="pet-image">
                <h4><%= pet.petName %></h4>
                <p><strong>Age:</strong> <%= pet.petAge %> Years</p>
                <p><strong>Breed:</strong> <%= pet.petBreed %></p>
                <p><strong>Price:</strong> <%= pet.petPrice %> Rs</p>
                <p><strong>Description:</strong> <%= pet.petDescription %></p>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-container">
            <div class="footer-section">
                <h3><a href="/About_Us" class="about">About Us</a></h3>
                <p>We are dedicated to helping you find the perfect pet companion. Learn more about our story and mission.</p>
            </div>
            <div class="footer-section">
                <h3>Become a Partner</h3>
                <p>Join our community of trusted pet shops and sellers. Register today to showcase your pets and connect with loving homes, while we help you manage the process effortlessly.</p>
                <a href="/Regester" class="about">Register as a Partner</a>
            </div>
            <div class="footer-section">
                <h3>Follow Us</h3>
                <div class="social-icons">
                    <a href="#"><img width="48" height="48" src="https://img.icons8.com/color/48/facebook.png" alt="facebook"/></a>
                    <a href="#"><img width="48" height="48" src="https://img.icons8.com/fluency/48/instagram-new.png" alt="instagram-new"/></a>
                    <a href="#"><img width="48" height="48" src="https://img.icons8.com/color/48/twitter--v1.png" alt="twitter--v1"/></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 PetAdopt. All rights reserved.</p>
            <p>Designed with ❤️ by <a href="#" class="about">Your Name</a></p>
        </div>
    </footer>

    <!-- Include Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        // Initialize Flatpickr for the expiration date
        flatpickr("#expiration-date", {
            dateFormat: "m/Y",   // Format as MM/YYYY
            minDate: "today",    // Prevent selecting past dates
            disableMobile: "true" // Disable mobile version for better control
        });

        // Function to toggle visibility of the credit card fields
        function togglePaymentFields() {
            const paymentMethod = document.getElementById('payment-method').value;
            const creditCardInfo = document.getElementById('credit-card-info');

            // Show or hide the credit card fields based on the selected payment method
            if (paymentMethod === 'credit-card') {
                creditCardInfo.style.display = 'block';
            } else {
                creditCardInfo.style.display = 'none';
            }
        }

        // Add event listener to toggle fields when payment method changes
        document.getElementById('payment-method').addEventListener('change', togglePaymentFields);

        // Trigger the function to set the correct initial state based on the default value
        togglePaymentFields();

        
    
        // Success Alert Logic
        const successAlert = document.getElementById('successAlert');
        const closeSuccess = document.getElementById('closeSuccess');
        if (successAlert) {
          successAlert.style.display = 'flex';
          closeSuccess.addEventListener('click', () => {
            successAlert.style.display = 'none';
            window.location.href = '/dashboard'; // Redirect after closing success modal
          });
    
          // Auto-close after 3 seconds
          setTimeout(() => {
            successAlert.style.display = 'none';
            window.location.href = '/dashboard';
          }, 2000);
        }
    </script>
</body>
</html>
